# ---- Mode ----
# mock = simulated G$ balances (demo). celo = real GoodDollar contracts on Celo mainnet.
CHAIN_MODE=mock
# mock = simulated top-ups. vtpass / falconpay = airtime/data/electricity (sandbox or live credentials)
TOPUP_PROVIDER=mock
# Real and simulated money never mix. The only configurations that pay bills are:
#   CHAIN_MODE=mock + a simulated provider (mock with DEMO_BILLS=true, VTPASS_ENV=sandbox, or an sk_test_ FalconPay key)
#   CHAIN_MODE=celo + a live provider      (VTPASS_ENV=live, or an sk_live_ FalconPay key)
# CHAIN_MODE=celo + TOPUP_PROVIDER=mock (DEMO_BILLS unset) runs with bills switched off.
# Anything else is refused: bills and demo top-ups are disabled and the reason is logged at startup.
APP_URL=http://localhost:3400   # production: https://usejara.xyz

# ---- Celo (CHAIN_MODE=celo) ----
CELO_RPC_URL=https://forno.celo.org
# Receives G$ for bills, pays streak bonuses, tops up agent gas. Keep it funded with CELO + G$.
TREASURY_PRIVATE_KEY=
# ---- Agent wallet key custody ----
# Every agent wallet key is encrypted with its own data key; this chooses what wraps those data keys.
#   aws-kms  (production) a key inside AWS KMS. It never leaves the HSM, each unwrap is one
#            IAM-authorized, CloudTrail-logged call naming the wallet, and access is revocable.
#   local    (development) WALLET_ENCRYPTION_KEY below, stored on this server.
WALLET_KEY_PROVIDER=local
# aws-kms: a symmetric KMS key (ARN or alias/...), its region, and an IAM user allowed ONLY
# kms:Encrypt and kms:Decrypt on that one key.
WALLET_KMS_KEY_ID=
WALLET_KMS_REGION=
WALLET_KMS_ACCESS_KEY_ID=
WALLET_KMS_SECRET_ACCESS_KEY=
# 64 hex chars (`openssl rand -hex 32`). Used by WALLET_KEY_PROVIDER=local, and to read wallet
# keys stored before per-wallet encryption. Once /api/admin/treasury?custody=1 reports
# "pending": 0 under aws-kms, delete it from the server.
WALLET_ENCRYPTION_KEY=
GAS_TOPUP_CELO=0.02
MIN_GAS_CELO=0.005
# After each claim, send the G$ on to the owner's own wallet so Jara-managed wallets stay empty
# (only for people who approved a spending limit; Jara pays that transfer's network fee).
FORWARD_CLAIMS=true
# Smaller amounts wait for the next claim rather than pay a fee to move.
FORWARD_MIN_GD=20

# ---- Pricing ----
# Fixed naira per G$ (leave empty for live CoinGecko price)
GD_NGN_RATE=
PRICE_SPREAD_BPS=200
MAX_BILL_NGN=20000

# ---- Rewards ----
STREAK_REWARD_DAYS=7
STREAK_REWARD_GD=500
# Referral campaign lifetime and UTC-day limits. Reservations survive timeouts/restarts.
# Zero pauses new reservations; existing payout obligations still recover.
REFERRAL_CAMPAIGN_BUDGET_GD=10000
REFERRAL_DAILY_BUDGET_GD=2000

# ---- Agent brain (AntSeed buyer proxy by default; any OpenAI-compatible endpoint works) ----
LLM_BASE_URL=http://localhost:8377/v1
LLM_API_KEY=antseed
LLM_MODEL=deepseek-v4-flash
ANTSEED_PIN_PEER=
LLM_DISABLED=false
# Max LLM calls per day across all users (each costs USDC on AntSeed)
LLM_DAILY_CALL_CAP=3000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---- FalconPay (sk_test_ = sandbox, sk_live_ = live) ----
FALCONPAY_API_KEY=
FALCONPAY_WEBHOOK_SECRET=

# ---- VTpass ----
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# ---- Storage / cron ----
# Empty uses jara-demo.db for mock, jara.db for Celo. Never reuse one DB across modes.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
CRON_SECRET=

# Operator treasury page (/admin/treasury)
ADMIN_KEY=
# Optional fixed G$ price in USD for the treasury view (else CoinGecko)
GD_USD_RATE=

# Local demo only (CHAIN_MODE=mock): let bill payments run against the mock provider
DEMO_BILLS=false

# JaraTelemetry contract on Celo (see contracts/). Reporter key needs a little CELO for gas.
TELEMETRY_CONTRACT=
TELEMETRY_REPORTER_KEY=

# Lets phone wallets connect by QR / deep link (free project ID from https://cloud.reown.com). Leave empty to show browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# One "Connect" button: Google/email login + MetaMask + WalletConnect (Web3Auth Modal v10).
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# ---- Keyless claim migration (Celo) ----
# Deploy reviewed contracts with scripts/deploy-custody.mjs; then set these together.
# New accounts have no agent key. Existing users upgrade once in Profile.
CLAIMER_FACTORY_ADDRESS=
# Optional for claims, required for upgraded users to pay bills/AI. No raw-allowance fallback.
SPENDING_CONTRACT_ADDRESS=
# Retain the legacy WALLET_* configuration while old keys/funds require recovery.
